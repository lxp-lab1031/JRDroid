<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- INTERNET is required for the on-device 127.0.0.1 RTL-TCP connection. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-feature android:name="android.hardware.usb.host" android:required="true" />
    <queries><package android:name="marto.rtl_tcp_andro" /></queries>
    <application android:label="@string/app_name" android:theme="@style/AppTheme"
        android:allowBackup="false" android:supportsRtl="true"
        android:icon="@drawable/ic_radio" android:usesCleartextTraffic="false">
        <activity android:name=".MainActivity" android:exported="true" android:screenOrientation="portrait">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <service android:name=".ReceiverService" android:exported="false" android:foregroundServiceType="mediaPlayback" />
        <provider android:name=".IqCaptureProvider" android:authorities="${applicationId}.iq-capture"
            android:exported="false" android:grantUriPermissions="true" />
    </application>
</manifest>
